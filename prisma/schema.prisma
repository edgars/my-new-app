generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Nccruise {
  id        Int      @id @default(autoincrement())
  cruiseStatus  String
  startDate  Float?
  startTime  Float
  endDate  Float
  endTime  Float
  startHarbor  String?
  destinationHarbor  String?
  idYacht  Float
  price1W  Decimal
  price2W  Decimal
  price3W  Decimal
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("nccruise")
}

model Ncyacht {
  id        Int      @id @default(autoincrement())
  yachtName  String
  yachtType  String
  length  Decimal
  width  Decimal
  draft  Decimal
  sailSurface  Decimal
  motor  Decimal
  headRoom  Decimal
  bunks  Decimal
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ncyacht")
}

