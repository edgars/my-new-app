generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Nextcust {
  id        Int      @id @default(autoincrement())
  newcust  Float?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("nextcust")
}

model Parts {
  id        Int      @id @default(autoincrement())
  partno  Float
  description  String
  onhand  Float?
  onorder  Float?
  vendorno  Float?
  cost  Decimal?
  listprice  Decimal?
  backord  Boolean?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("parts")
}

model Vendors {
  id        Int      @id @default(autoincrement())
  vendorName  String
  contactEmail  String?
  activeStatus  Boolean?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("vendors")
}

model Orders {
  id        Int      @id @default(autoincrement())
  orderno  Float?
  custno  Float
  saledate  DateTime?
  shipdate  DateTime?
  shiptocontact  String?
  shiptoaddr1  String?
  shiptoaddr2  String?
  shiptocity  String?
  shiptostate  String?
  shiptozip  String?
  shiptocountry  String?
  shiptophone  String?
  shipvia  String?
  po  String?
  empno  Int
  terms  String?
  paymentmethod  String?
  itemstotal  Decimal?
  taxrate  Float?
  taxtotal  Decimal?
  freight  Decimal?
  amountpaid  Decimal?
  amountdue  Decimal?
  salesperson  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("orders")
}

model Customer {
  id        Int      @id @default(autoincrement())
  custno  Float?
  company  String?
  addr1  String?
  addr2  String?
  city  String?
  state  String?
  zip  String?
  country  String?
  phone  String?
  fax  String?
  taxrate  Float?
  contact  String?
  lastinvoicedate  DateTime?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("customer")
}

model Items {
  id        Int      @id @default(autoincrement())
  itemno  Float?
  orderno  Float?
  description  String?
  sellprice  Decimal?
  qty  Int?
  discount  Float?
  extprice  Decimal?
  partno  Float?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("items")
}

model Nextord {
  id        Int      @id @default(autoincrement())
  newkey  Float?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("nextord")
}

model Employee {
  id        Int      @id @default(autoincrement())
  empno  Int?
  fullname  String?
  lastname  String?
  firstname  String?
  phoneext  String?
  hiredate  DateTime?
  salary  Float?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("employee")
}

