generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Curso {
  id  Int  @id @default(autoincrement())
  abvCurso  String
  nomeCurso  String
  ativo  String
  interesseCorporacao  String
  dataUltAlteracao  DateTime
  usuarioUltAlteracao  String
  versao  Int
  abvCurso  String
  interesseCorporacao  String
  nomeCurso  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("curso")
}

