model TipoFuncionario {
  id  Int  @id @default(autoincrement())
  tipo  String
  categoriaSiarhes  String
  militar  String
  ignorarImportacao  String
  dataUltAlteracao  DateTime
  usuarioUltAlteracao  String
  versao  Int
  categoriaSiarhes  String
  ignorarImportacao  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tipo_funcionario")
}

model AuditoriaDetalhadaFuncionario {
  id  Int  @id @default(autoincrement())
  tabela  String
  data  DateTime
  nfFuncionario  String?
  evento  String?
  observacao  String?
  dataUltAlteracao  DateTime
  usuarioUltAlteracao  String
  versao  Int
  nfFuncionario  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("auditoria_detalhada_funcionario")
}

model FuncaoQdi {
  id  Int  @id @default(autoincrement())
  nomeFuncao  String
  nomeFuncaoSiarhes  String?
  ativo  String
  geral  String
  gratificada  String
  dataUltAlteracao  DateTime
  usuarioUltAlteracao  String
  versao  Int
  nomeFuncao  String
  nomeFuncaosiarhes  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("funcao_qdi")
}


model UiSetting {
  entity    String   @id
  columns   String
  updatedAt DateTime @updatedAt
}
