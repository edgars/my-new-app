generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Auditoria {
  id  Int  @id @default(autoincrement())
  numAuditoria  Float?
  dtEvento  Float?
  hrEvento  Float?
  tsEvento  Float?
  codAcao  String?
  codModulo  String?
  desAcao  String?
  tipoEntidade  String?
  idEntidade  String?
  numCpfAfetado  String?
  usrEvento  String?
  nomeUsuario  String?
  codPerfil  String?
  codLotacao  String?
  ipOrigem  String?
  idSessao  String?
  numCicloBatch  Float?
  numSeqBatch  Float?
  nomJobBatch  String?
  sitBatch  String?
  desErroBatch  String?
  idCorrelacao  String?
  numSeqCorrelacao  Float?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("auditoria")
}

model Pagamento {
  id  Int  @id @default(autoincrement())
  numPagamento  Float?
  numCpf  String?
  numInscricao  Float?
  codPrograma  String?
  anoMesRef  Float?
  numCiclo  Float?
  vlrBruto  Float?
  vlrLiquido  Float?
  vlrDescontoTotal  Float?
  sitPagamento  String?
  dtGeracao  Float?
  hrGeracao  Float?
  dtEmissao  Float?
  dtConfirmacao  Float?
  dtCancelamento  Float?
  motCancelamento  String?
  codBanco  String?
  codAgencia  String?
  numConta  String?
  tipoConta  String?
  codOperacao  String?
  numObSiafi  String?
  numNeSiafi  String?
  codUgEmitente  String?
  codGestao  String?
  sitIntegSiafi  String?
  dtConciliacao  Float?
  sitConciliacao  String?
  vlrConciliado  Float?
  codRetornoBanco  String?
  desRetornoBanco  String?
  hashArqRemessa  String?
  hashArqRetorno  String?
  dtInclusao  Float?
  hrInclusao  Float?
  usrInclusao  String?
  dtUltAlteracao  Float?
  hrUltAlteracao  Float?
  usrUltAlteracao  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pagamento")
}

model PagamentoGrpDesconto {
  occurrence  Int  @id @default(autoincrement())
  tipoDesconto  String?
  vlrDesconto  Float?
  pctDesconto  Float?
  numProcesso  String?
  dtInicioDsct  Float?
  dtFimDsct  Float?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pagamento_grp_desconto")
}

model ProgramaSocial {
  id  Int  @id @default(autoincrement())
  codPrograma  String?
  nomePrograma  String?
  siglaPrograma  String?
  tipoPrograma  String?
  orgaoResponsavel  String?
  leiCriacao  String?
  dtCriacao  Float?
  dtEncerramento  Float?
  sitPrograma  String?
  vlrBaseIndividual  Float?
  vlrBaseFamiliar  Float?
  vlrTetoBenef  Float?
  vlrPisoBenef  Float?
  pctReajusteAnual  Float?
  dtUltReajuste  Float?
  fatorK  Float?
  rendaMaxPercap  Float?
  idadeMin  Float?
  idadeMax  Float?
  indExigeFilhos  String?
  qtdMinFilhos  Float?
  indExigeEscola  String?
  indExigeVacina  String?
  indExigePrenatal  String?
  indExigeBiometria  String?
  dtInclusao  Float?
  usrInclusao  String?
  dtUltAlteracao  Float?
  usrUltAlteracao  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("programa_social")
}

model ProgramaSocialGrpFaixaCalculo {
  occurrence  Int  @id @default(autoincrement())
  rendaInicio  Float?
  rendaFim  Float?
  fatorMultiplicador  Float?
  vlrAdicional  Float?
  indAcumulativo  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("programa_social_grp_faixa_calculo")
}

model ProgramaSocialGrpParamRegional {
  occurrence  Int  @id @default(autoincrement())
  codRegiao  String?
  fatorRegional  Float?
  vlrComplementoReg  Float?
  indAtivoRegiao  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("programa_social_grp_param_regional")
}

model Beneficiario {
  id  Int  @id @default(autoincrement())
  numInscricao  Float?
  numCpf  String?
  nomeCompleto  String?
  nomeMae  String?
  nomePai  String?
  dtNascimento  Float?
  sexo  String?
  estCivil  String?
  rgNumero  String?
  rgOrgao  String?
  rgUf  String?
  rgDtExpedicao  Float?
  logradouro  String?
  numero  String?
  complemento  String?
  bairro  String?
  municipio  String?
  uf  String?
  cep  Float?
  codIbge  Float?
  codRegiao  String?
  codPrograma  String?
  dtCadastro  Float?
  dtInicioBenef  Float?
  dtFimBenef  Float?
  sitBeneficiario  String?
  motSituacao  String?
  dtUltSituacao  Float?
  vlrRendaFamiliar  Float?
  qtdMembrosFamilia  Float?
  indRendaPercap  Float?
  telFixo  String?
  telCelular  String?
  email  String?
  indBiometria  String?
  dtColetaBio  Float?
  codPostoBio  String?
  hashDigital  String?
  dtInclusao  Float?
  hrInclusao  Float?
  usrInclusao  String?
  dtUltAlteracao  Float?
  hrUltAlteracao  Float?
  usrUltAlteracao  String?
  numVersao  Float?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("beneficiario")
}

model BeneficiarioGrpDependente {
  occurrence  Int  @id @default(autoincrement())
  cpfDependente  String?
  nomeDependente  String?
  dtNascDepend  Float?
  parentesco  String?
  sitDependente  String?
  indDeficiencia  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("beneficiario_grp_dependente")
}


model UiSetting {
  entity    String   @id
  columns   String
  updatedAt DateTime @updatedAt
}
