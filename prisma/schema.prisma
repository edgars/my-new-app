model Lotacao {
  id  Int  @id @default(autoincrement())
  funcionarioAuxLookup  String?
  dataInicio  DateTime?
  dataFim  DateTime?
  atual  String?
  substituicao  String?
  ativo  String?
  obs  String?
  dataUltAlteracao  DateTime
  usuarioUltAlteracao  String
  versao  Int
  dataFim  DateTime?
  dataInicio  DateTime?
  funcaoqdi  Int
  funcionario  Int?
  local  Int
  postoGraduacao  Int?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("lotacao")
}

model MesAnoFerias {
  id  Int  @id @default(autoincrement())
  mes  String
  ano  Int
  funcionario  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mes_ano_ferias")
}


model UiSetting {
  entity    String   @id
  columns   String
  updatedAt DateTime @updatedAt
}
